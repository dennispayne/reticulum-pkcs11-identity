{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pytest: All tests (SoftHSM2)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "PKCS11_TEST_TOKEN": "softhsm"
      }
    },
    {
      "name": "Pytest: All tests (auto-detect)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "envFile": "${workspaceFolder}/.vscode/.env",
      "detail": "Default: prefers SoftHSM2, falls back to YubiKey if available and PIN set"
    },
    {
      "name": "Pytest: All tests (YubiKey hardware)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "PKCS11_TEST_TOKEN": "yubikey"
      }
    },
    {
      "name": "Pytest: Current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "-s"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "envFile": "${workspaceFolder}/.vscode/.env"
    },
    {
      "name": "Pytest: Current file (YubiKey hardware)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "-s"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "envFile": "${workspaceFolder}/.vscode/.env",
      "env": {
        "PKCS11_TEST_TOKEN": "yubikey"
      }
    },
    {
      "name": "Module: Show hardware token status",
      "type": "debugpy",
      "request": "launch",
      "module": "reticulum_pkcs11_identity.cli",
      "args": [
        "list-tokens"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug: PKCS#11 thread-race repro",
      "type": "debugpy",
      "request": "launch",
      "module": "tests.e2e._stress_token_threads",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "cwd": "${workspaceFolder}",
      "env": {
        "STRESS_ITERS": "8000",
        "STRESS_SECONDS": "40"
      },
      "detail": "Deterministic two-thread (sign||decrypt) reproduction of the SoftHSM2 e2e flake. Set breakpoints in token_monitor.get_provider_state / identity._check_token_state / backend.sign to watch both threads enter the PKCS#11 module. Crashes within seconds WITHOUT the shared-lock fix; survives WITH it."
    }
  ]
}
