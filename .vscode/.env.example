# Copy this file to .vscode/.env for local debugging and test runs.
# Leave values empty when not needed.

# ===== Test Token Selection =====
# PKCS11_TEST_TOKEN: 'hw' for YubiKey, 'softhsm' for software (auto-detect by default)
# PKCS11_TEST_PIN: User PIN for hardware token (required if PKCS11_TEST_TOKEN=hw)
# PKCS11_TEST_LABEL: Token label (auto-detected for YubiKey)
#
# Examples:
#   PKCS11_TEST_TOKEN=hw
#   PKCS11_TEST_PIN=123456
#
# Or for SoftHSM2 explicitly:
#   PKCS11_TEST_TOKEN=softhsm

PKCS11_TEST_TOKEN=
PKCS11_TEST_PIN=
PKCS11_TEST_LABEL=
PKCS11_TEST_ADMIN_PIN=

# ===== SoftHSM2 Configuration =====
# Optional: explicit path to the SoftHSM2 module used by tests/fixtures.
# Leave empty to auto-detect from standard installation paths.
SOFTHSM2_MODULE=

# ===== Legacy/Manual Configuration =====
# These are for manual debugging or examples. Leave empty for normal test runs.
PKCS11_TOKEN_LABEL=
RETICULUM_PKCS11_PIN=
