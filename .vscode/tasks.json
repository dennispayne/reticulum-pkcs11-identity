{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Install editable test deps",
      "type": "shell",
      "command": "bash",
      "linux": {
        "command": "bash",
        "args": [
          "scripts/bootstrap_test_env.sh"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "scripts/bootstrap_test_env.sh"
        ]
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "-m",
          "pip",
          "install",
          "-e",
          ".[test]"
        ]
      },
      "args": [
        "scripts/bootstrap_test_env.sh"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Tests: Run all (SoftHSM2, default)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "-m",
          "pytest",
          "tests",
          "-v"
        ]
      },
      "args": [
        "-m",
        "pytest",
        "tests",
        "-v"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Default: uses SoftHSM2. Set PKCS11_TEST_TOKEN=yubikey to test with YubiKey."
    },
    {
      "label": "Tests: Run all (quick, no verbose)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "-m",
          "pytest",
          "tests",
          "-q"
        ]
      },
      "args": [
        "-m",
        "pytest",
        "tests",
        "-q"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests: Run current file",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "-m",
          "pytest",
          "${file}",
          "-v"
        ]
      },
      "args": [
        "-m",
        "pytest",
        "${file}",
        "-v"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests: Run selected node",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "-m",
          "pytest",
          "${input:pytestNodeId}",
          "-v"
        ]
      },
      "args": [
        "-m",
        "pytest",
        "${input:pytestNodeId}",
        "-v"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests: Run with coverage",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "-m",
          "pytest",
          "tests",
          "-v",
          "--cov=reticulum_pkcs11_identity",
          "--cov-report=html",
          "--cov-report=term-missing"
        ]
      },
      "args": [
        "-m",
        "pytest",
        "tests",
        "-v",
        "--cov=reticulum_pkcs11_identity",
        "--cov-report=html",
        "--cov-report=term-missing"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Tests: Run with YubiKey hardware",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "-m",
          "pytest",
          "tests",
          "-v"
        ],
        "env": {
          "PKCS11_TEST_TOKEN": "yubikey"
        }
      },
      "args": [
        "-m",
        "pytest",
        "tests",
        "-v"
      ],
      "env": {
        "PKCS11_TEST_TOKEN": "yubikey"
      },
      "group": "test",
      "problemMatcher": [],
      "detail": "Requires: YubiKey plugged in and PKCS11_TEST_PIN set in .vscode/.env or shell environment"
    },
    {
      "label": "CLI: List available PKCS#11 tokens",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\rnidstatus",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/rnidstatus"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/rnidstatus"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\rnidstatus.exe",
        "args": [
          "list-tokens"
        ]
      },
      "args": [
        "list-tokens"
      ],
      "group": "none",
      "problemMatcher": [],
      "detail": "Discover available YubiKey and SoftHSM2 tokens"
    },
    {
      "label": "CLI: Show identity status",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\rnidstatus",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/rnidstatus"
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/rnidstatus"
      },
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\rnidstatus.exe",
        "args": [
          "show"
        ]
      },
      "args": [
        "show"
      ],
      "group": "none",
      "problemMatcher": [],
      "detail": "Display current hardware identity status"
    }
  ],
  "inputs": [
    {
      "id": "pytestNodeId",
      "type": "promptString",
      "description": "Pytest node id (example: tests/unit/test_backend_errors.py::TestECPointConversion::test_ec_point_to_raw_too_short_raises)",
      "default": "tests/unit/test_backend_errors.py::TestECPointConversion"
    }
  ]
}
